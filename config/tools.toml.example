# Default: absent value = enabled.

[tools]
skills_search = true
skills_read = true
run_command = true
get_queue_state = true
get_command_state = true
stop_command = true
get_command_output = true
get_command_log = true
resolve_command_recovery = true
public_file_share = true
public_file_list = true
public_file_revoke = true
launch_agent = true

[downstream_mcp.filesystem]
enabled = true

[downstream_mcp.filesystem.tools]
read_file = true
write_file = true
list_directory = true

[downstream_mcp.puppeteer]
enabled = true

[downstream_mcp.puppeteer.tools]
navigate = true
screenshot = true
click = true
