# ─────────────────────────────────────────────────────────────────────
# MCP Gateway environment variables
# ─────────────────────────────────────────────────────────────────────
# Copy this file beside itself as config/.env and adjust the values.
#
#   cp config/.env.example config/.env
#
# MCP_BASE_URL, OAUTH_ACCESS_SECRET, and OAUTH_ACCESS_SECRET_HASH are required.
# ─────────────────────────────────────────────────────────────────────

# ── Public gateway URL ───────────────────────────────────────────────
# ngrok URL, or another public URL, pointing to gateway port 8761.
# Example: https://xxxx-xxxx-xxxx.ngrok-free.dev
MCP_BASE_URL=https://hull-envision-bunkbed.ngrok-free.dev
MCP_SERVERS_CONFIG=config/mcp.json

# ── OAuth ────────────────────────────────────────────────────────────
# OAuth issuer, must match MCP_BASE_URL + /oauth.
# Default: <MCP_BASE_URL>/oauth
# OAUTH_ISSUER=https://hull-envision-bunkbed.ngrok-free.dev/oauth

# Audience for issued JWT tokens.
# Default: https://mcp.local
# OAUTH_AUDIENCE=https://mcp.local

# Argon2id hash of the secret required on every new OAuth authorization.
# Generate with: python -c "from getpass import getpass; from argon2 import PasswordHasher; print(PasswordHasher().hash(getpass('OAuth access secret: ')))"
OAUTH_ACCESS_SECRET=REPLACE_WITH_YOUR_READABLE_SECRET
OAUTH_ACCESS_SECRET_HASH=$argon2id$REPLACE_WITH_YOUR_HASH

# Rotate both values together with: ./run.sh renew-secret

# Token lifetime, in seconds.
# Default: 2592000, 30 days.
OAUTH_TOKEN_TTL_SECONDS=2592000

# Failed login attempts allowed per IP during one fixed minute window.
# Default: 5.
OAUTH_LOGIN_MAX_ATTEMPTS=5

# Proxy CIDRs allowed to supply X-Forwarded-For. Empty means never trust it.
# Example for a reverse proxy bound to loopback: 127.0.0.0/8,::1/128
# OAUTH_TRUSTED_PROXY_NETWORKS=

# OAuth key ID in the JWKS.
# Default: local-dev-key
# OAUTH_KEY_ID=local-dev-key

# Automatically register unknown clients during authorization.
# Default: true
# OAUTH_AUTO_REGISTER_AUTH_CLIENTS=true

# Standalone OAuth server port, only used when launched separately.
# Default: 8762
# OAUTH_PORT=8762

# ── Gateway ─────────────────────────────────────────────────────────
# Audience used by the JWT token verifier.
# Default: https://mcp.local
# MCP_AUDIENCE=https://mcp.local

# Enable or disable OAuth authentication on the gateway.
# Default: true
# ENABLE_OAUTH=true

# Automatically open or focus Chrome when a conversation starts.
# Default: false, to avoid unexpected Chrome windows.
# CHATGPT_STARTUP_BROWSER_ASSIST=false

# Trusted local Agent Skills root. Skills are discovered recursively at request time.
# Default: ~/.gate/skills. The onboarding launcher creates the configured root.
# Add each skill as a directory containing SKILL.md, or as a symlink to such a directory.
# MCP_SKILLS_ROOT=~/.gate/skills

# Directories exposed by the downstream filesystem MCP server.
# Default: volume root. Separate multiple paths with ":" on macOS/Linux
# and ";" on Windows.
# MCP_FILESYSTEM_ROOTS=/absolute/path/one:/absolute/path/two

# Asynchronous run_command queue limits
# Attach the MCP App widget to run_command responses.
# Default: false.
MCP_WIDGET_ENABLED=false

# Return immediately with an execution ID and expose live status tools.
# Set false to restore the historical blocking run_command response.
# Default: true.
MCP_REALTIME_STATUS_ENABLED=false

MCP_COMMAND_TIMEOUT_SECONDS=300
MCP_MAX_CONCURRENT_COMMANDS=4
MCP_COMMAND_MAX_LINES=20000
MCP_COMMAND_HISTORY_LIMIT=2000
# Default: data/commands.sqlite3
# MCP_COMMAND_DATABASE=/absolute/path/to/commands.sqlite3
