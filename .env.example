# ─────────────────────────────────────────────────────────────────────
# MCP Gateway — variables d'environnement
# ─────────────────────────────────────────────────────────────────────
# Copier ce fichier vers  config/.env  ou  .env  et ajuster les valeurs.
#
#   cp .env.example .env
#
# Seul MCP_BASE_URL est obligatoire pour le fonctionnement nominal.
# ─────────────────────────────────────────────────────────────────────

# ── URL publique du gateway ─────────────────────────────────────────
# URL ngrok (ou autre) vers le port 8761 du gateway.
# Exemple: https://xxxx-xxxx-xxxx.ngrok-free.dev
MCP_BASE_URL=https://hull-envision-bunkbed.ngrok-free.dev

# ── OAuth ───────────────────────────────────────────────────────────
# Issuer OAuth (doit correspondre à MCP_BASE_URL + /oauth).
# Par défaut: <MCP_BASE_URL>/oauth
# OAUTH_ISSUER=https://hull-envision-bunkbed.ngrok-free.dev/oauth

# Audience des tokens JWT émis.
# Par défaut: https://mcp.local
# OAUTH_AUDIENCE=https://mcp.local

# Durée de validité des tokens (secondes).
# Par défaut: 3600 (1 heure)
# OAUTH_TOKEN_TTL_SECONDS=3600

# ID de la clé OAuth dans le JWKS.
# Par défaut: local-dev-key
# OAUTH_KEY_ID=local-dev-key

# Enregistrement automatique des clients inconnus à l'authorize.
# Par défaut: true
# OAUTH_AUTO_REGISTER_AUTH_CLIENTS=true

# Port du serveur OAuth standalone (uniquement si lancé séparément).
# Par défaut: 8762
# OAUTH_PORT=8762

# ── Gateway ─────────────────────────────────────────────────────────
# Audience utilisée par le vérificateur de token JWT.
# Par défaut: https://mcp.local
# MCP_AUDIENCE=https://mcp.local

# Activer/désactiver l'authentification OAuth sur le gateway.
# Par défaut: true
# ENABLE_OAUTH=true
