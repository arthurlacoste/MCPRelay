# ── Sensitive files ──────────────────────────────────────────────
.env
config/settings.yaml

# ── Data (OAuth secrets, tokens, file shares) ────────────────────
data/

# ── Logs ─────────────────────────────────────────────────────────
logs/

# ── Docs (plans, notes internes) ─────────────────────────────────
# Installation + comptes-rendus doivent rester versionnés.
docs/*
!docs/installation.md
!docs/assets/
!docs/assets/*.webp

# ── Archives / backups ───────────────────────────────────────────
archive/

# ── Python cache ─────────────────────────────────────────────────
__pycache__/
.pytest_cache/
*.pyc

# ── Virtual environment ──────────────────────────────────────────
.venv/

# ── macOS ────────────────────────────────────────────────────────
.DS_Store
node_modules/*
